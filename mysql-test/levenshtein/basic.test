SELECT LEVENSHTEIN('', '');
SELECT LEVENSHTEIN('', 'abc');
SELECT LEVENSHTEIN('kitten', 'sitting');
SELECT LEVENSHTEIN('flaw', 'lawn');
SELECT LEVENSHTEIN(_utf8mb4'café', _utf8mb4'cafe');
SELECT LEVENSHTEIN(_utf8mb4'😀', _utf8mb4'😃');
SELECT LEVENSHTEIN(NULL, 'abc');

SELECT ROUND(LEVENSHTEIN_RATIO('', ''), 6);
SELECT ROUND(LEVENSHTEIN_RATIO('', 'abc'), 6);
SELECT ROUND(LEVENSHTEIN_RATIO('kitten', 'sitting'), 6);
SELECT ROUND(LEVENSHTEIN_RATIO('same', 'same'), 6);
SELECT LEVENSHTEIN_RATIO(NULL, 'abc');

SELECT LEVENSHTEIN_WITH_LIMIT('kitten', 'sitting', 3);
SELECT LEVENSHTEIN_WITH_LIMIT('kitten', 'sitting', 2);
SELECT LEVENSHTEIN_WITH_LIMIT('', 'abc', 3);
SELECT LEVENSHTEIN_WITH_LIMIT('', 'abc', 2);
SELECT LEVENSHTEIN_WITH_LIMIT('abc', 'abc', -1);

SELECT DAMERAU_LEVENSHTEIN('form', 'from');
SELECT LEVENSHTEIN('form', 'from');
SELECT ROUND(DAMERAU_LEVENSHTEIN_RATIO('form', 'from'), 6);
SELECT DAMERAU_LEVENSHTEIN(_utf8mb4'😀a', _utf8mb4'a😀');

SELECT LEVENSHTEIN_SIMILAR('kitten', 'sitting', 0.5);
SELECT LEVENSHTEIN_SIMILAR('kitten', 'sitting', 0.6);
SELECT LEVENSHTEIN_SIMILAR('', '', 1.0);
SELECT LEVENSHTEIN_SIMILAR('a', 'b', 1.1);

SELECT LEVENSHTEIN_WEIGHTED('abc', 'axc', 1, 1, 3);
SELECT LEVENSHTEIN_WEIGHTED('abc', 'abxc', 2, 1, 3);
SELECT LEVENSHTEIN_WEIGHTED('abc', 'axc', 1, 1, -1);

SELECT LEVENSHTEIN_EDITOPS('', '');
SELECT LEVENSHTEIN_EDITOPS('abc', 'axc');
SELECT LEVENSHTEIN_EDITOPS('abc', 'abxc');
SELECT LEVENSHTEIN_EDITOPS(NULL, 'abc');

--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT LEVENSHTEIN('one');
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT LEVENSHTEIN_RATIO('one', 'two', 'three');
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT LEVENSHTEIN_WEIGHTED('one', 'two', 1);
